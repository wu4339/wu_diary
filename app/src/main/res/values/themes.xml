<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WuDiary" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/background</item>
        <!-- 所有提示弹窗统一使用圆角背景 -->
        <item name="alertDialogTheme">@style/Theme.WuDiary.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.WuDiary.Dialog</item>
    </style>

    <style name="Theme.WuDiary.Dialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:backgroundDimAmount">0.3</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.WuDiary.Editor" parent="Theme.WuDiary">
        <item name="android:windowAnimationStyle">@style/WindowAnimationNone</item>
    </style>

    <style name="Theme.WuDiary.Transparent" parent="Theme.WuDiary">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationNone</item>
        <item name="android:windowDisablePreview">true</item>
        <!-- 分享接收页不显示界面，系统状态栏/导航栏同样保持透明，避免闪白。 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <style name="WindowAnimationNone">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>
</resources>
